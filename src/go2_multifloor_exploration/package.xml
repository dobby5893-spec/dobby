<?xml version="1.0"?>
<package format="3">
  <name>go2_multifloor_exploration</name>
  <version>0.1.0</version>
  <description>Hybrid 2D floor exploration and support-surface 3D stair transitions for Go2.</description>
  <maintainer email="dobby@example.com">dobby</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>frontier_exploration_ros2</depend>
  <depend>geometry_msgs</depend>
  <depend>go2_surface_3d_planner</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>fastlio_nav_bridge</exec_depend>
  <exec_depend>go2_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>scan_planner_nav2_controller</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
