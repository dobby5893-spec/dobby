<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fastlio_nav_bridge</name>
  <version>0.0.0</version>
  <description>FAST-LIO integration for Go2 navigation and 3D mapping</description>
  <maintainer email="dobby@todo.todo">dobby</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>frontier_exploration_ros2</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <exec_depend>python3-numpy</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
