<?xml version="1.0"?>
<package format="3">
  <name>scan_planner_nav2_controller</name>
  <version>0.1.0</version>
  <description>Nav2 controller adapter for SCAN-Planner.</description>
  <maintainer email="dobby@example.com">dobby</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav2_core</depend>
  <depend>go2_nav2_recovery</depend>
  <depend>go2_surface_3d_planner</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>scan_planner</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/scan_planner_controller.xml"/>
  </export>
</package>
